    <visual>
      <origin xyz="0 0 -0.213" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/foot.obj"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="FL_calf1_collision">
      <origin xyz="0.008 0 -0.06" rpy="0 -0.209614 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.12"/>
