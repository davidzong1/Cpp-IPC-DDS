    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="100" velocity="10"/>
  </joint>

  <!-- FR leg (mirror of FL) -->
  <link name="FR_hip">
    <inertial>
      <!-- original quat: 0.498237 0.505462 0.499245 0.497014 -->
      <origin xyz="-0.0054 -0.00194 -0.000105" rpy="0 0 0"/> <!-- placeholder -->
