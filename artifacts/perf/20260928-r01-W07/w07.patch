+    }
+    if (h->version != kLayoutVersion)
+    {
+        return "段头 layout_ver 与本版本不符";
+    }
+    if (h->max_entries != kMaxEntries)
+    {
+        return "段头 max_entries 与本版本不符";
+    }
+    return nullptr;
+}
