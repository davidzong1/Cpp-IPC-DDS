{
  "kind": "counter_snapshot_collector",
  "note": "采集器进程的计数器快照。各角色进程各自的计数随原始 CSV 落盘为 <case>.pub_raw.csv.counters.json / .sub_raw.csv.counters.json；跨进程汇总不做加法，只并列。",
  "counter_scope": {
    "path_message_counts": {
      "ids": ["tlv_messages", "dzflat_a_messages", "dzflat_b_messages"],
      "writers": ["transport_hook:src/dzIPC/common/nodelet_config.cc:NoteDzFlatPathDelivered"],
      "semantics": "实际交付路径(按真实分流: A/B/TLV), 含探测/预热/停止帧; DDS 档恒为 0(不经 dzIPC SHM 路径)",
      "harness_writes": false,
      "addressing": "读方直接采用; 与 summary.csv 的 pub_dzflat/pub_fallback 同源",
      "identity": "family(tlv+dzflat_a+dzflat_b) == pub_dzflat + pub_fallback (单测量窗口内, 末几条钩子计数可能落在读窗口外)"
    },
    "path_wire_bytes": {
      "ids": ["tlv_wire_bytes", "dzflat_wire_bytes"],
      "writers": ["transport_hook:NoteDzFlatPathDelivered"],
      "semantics": "实际传输字节(含段头/分片)",
      "harness_writes": false,
      "addressing": "读方直接采用"
    },
    "path_app_bytes": {
      "ids": ["tlv_bytes", "dzflat_a_bytes", "dzflat_b_bytes"],
      "writers": ["harness:test/xproc_benchmark.cpp (测量窗口内成功发布的应用逻辑载荷)"],
      "semantics": "= sent_ok × payload_bytes; 与 *_wire_bytes 口径不同",
      "harness_writes": true,
      "addressing": "⛔ 不得与 *_wire_bytes 相加, 也不得与 *_messages 相乘解读"
    },
    "case_level_counts": {
      "ids": ["plan", "attempts", "sent_ok", "send_failed", "recv_measure", "missing", "duplicate", "out_of_order"],
      "writers": ["harness:summary.csv / results.json (不经 CounterRegistry)"],
      "semantics": "用例级事实来源; 与 counters 的路径计数不同粒度",
      "harness_writes": true,
      "addressing": "判用例是否通过一律用这一组"
    }
  },
  "collector": {
  "kind": "counter_snapshot",
  "clock_source": "CLOCK_MONOTONIC",
  "diagnostics_enabled": false,
  "counters": {
    "tlv_messages": 0,
