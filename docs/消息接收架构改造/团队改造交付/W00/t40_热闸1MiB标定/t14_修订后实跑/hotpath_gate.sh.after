#!/usr/bin/env bash
#
# 热路径改动闸 —— 任何动 libipc 收/发路径的改法, 合入前必须过这里。
#
# 为什么要有它: 2026-09-21 的"跳过写头那一格"(commit 94b01e2 里带进 HEAD, 后由
# aa7e00c 撤掉)**通过了全部 9 个回归二进制**(chunk_hold/lap_safety/uf007/
# pool_exhaust/loan/dzflat_transport/dzflat_rx/dzflat_sercli/uf011), 却把
# **DZIPC 层的高速 pub/sub 打到零投递**:
#
#     payload   含该改法           撤掉后
#     1 MB      no message recv    1259 msg/s
#     64 B      49 msg/s           163396 msg/s
#
# ⇒ 那 9 个二进制覆盖的是 libipc 的**窄用法**, 而 dzIPC 层的 route/分片重组/用户态
#   队列路径一条都没走到。本脚本把那条路径补成硬门。
#
# 用法: bash docs/hotpath_gate.sh [BUILD_DIR] [RUN_ID]
#   退出码 0 = 过闸; 非 1 = 有一项没过。
#   ⚠️ 修订（队长 t14 批准）：输出目录由固定 `/tmp/hotpath_gate/` 改为
#      `/tmp/hotpath_gate/<run_id>/`（run_id 缺省取时间戳）。旧形态连续运行会
#      **互相覆盖**，事后无法对同一批读数做时间序列（实测：第一次 191 msg/s 的
#      原始文件被第二次运行覆盖，只能以控制台为准）。依据 W00 §11.4 D-30。
set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="${1:-${REPO_DIR}/build}"
RUN_ID="${2:-$(date '+%Y%m%d-%H%M%S')}"
export LD_LIBRARY_PATH="${BUILD_DIR}/lib:${BUILD_DIR}/bin"
# OUT 可被环境变量覆盖：默认 /tmp/hotpath_gate/<run_id>（run_id 保证不互相覆盖）；
# 需要跨会话归档读数时设 `HOTPATH_GATE_OUT=<仓库内目录>`（本机 /tmp 不作为持久存储）。
OUT="${HOTPATH_GATE_OUT:-/tmp/hotpath_gate}/${RUN_ID}"
mkdir -p "$OUT"
fail=0

echo "==> run_id=${RUN_ID}  输出=${OUT}"
{
    echo "run_id=${RUN_ID}"
    echo "时间=$(date '+%F %T %z')"
    echo "构建目录=${BUILD_DIR}"
    echo "git_HEAD=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo NA)"
    echo "governor=$(cat /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor 2>/dev/null || echo NA)"
    echo "nproc=$(nproc)"
    echo "loadavg=$(cat /proc/loadavg)"
} >"$OUT/run_header.txt"

# 池段是全机共享的: 只清**本脚本自己会用到的档位**, 且先确认没有活进程映射它。
# ⛔ 不用 /dev/shm 通配 —— 同机可能有别人的档位在用。
clear_pool() {
    local seg
    for seg in /dev/shm/*CHUNK_INFO__*; do
        [ -e "$seg" ] || continue
        grep -lq "$(basename "$seg")" /proc/[0-9]*/maps 2>/dev/null || rm -f "$seg"
    done
}

echo "==> 构建"
cmake --build "$BUILD_DIR" --target ipc dzipc_perf_benchmark \
      test_uf011_chunk_return test_chunk_hold test_lap_safety \
      test_uf007_id_pool_double_release test_loan \
      test_dzflat_transport test_dzflat_rx test_dzflat_sercli -j"$(nproc)" \
      >"$OUT/build.log" 2>&1 || { echo "构建失败, 见 $OUT/build.log"; exit 2; }

echo "==> 门 1: DZIPC 层高速 pub/sub 吞吐(A′ 就是死在这里)"
# ⛔ 判据不能只看"有没有报 FAILED" —— A′ 在 64B 档**没有报错**: 它只是把速率从
# 169741 打到 **29 msg/s**。只查错误串的判据会把这一行打上 ✓ 然后放行(实测过)。
#
# ---------------------------------------------------------------------------
# 1 MiB 档的判据形态修订（队长 t14 批准；依据 W00 §11.4 D-30）
# ---------------------------------------------------------------------------
# ⛔ 旧形态（`FLOOR_1M=700` 单轮采样）已被实测否定，且**不是**"余量偏薄"，
#    而是"通过/失败近似掷币"：
#   · 30 轮标定（严格同本门参数、每轮 clear_pool）：min=0 / 中位=1222 / max=1473、
#     CV=69.8%，**<700 的轮数 = 12/30（40%）**、零投递 4/30；
#   · **同一命令、同一二进制连续两次实跑给出相反判定**：191（未过闸） vs 1367（过闸）；
#   · 观测呈双峰且 **437↔838 之间无观测点**，而 700 正落在该空隙内 ⇒ 语义不可判；
#   · ⛔ 不是同机负载主导：全机 CPU 利用率实测 2.5%（/proc/stat 差商）、
#     轮前 load1 与速率 Pearson r=+0.110。
# 机制（可复核）：该档 chunk 池 = 40 块 × 1057792 B ≈ 40.4 MiB（段名
# `__IPC_SHM__CHUNK_INFO__1057792__C40`，空前缀=全机共享），开环 5 s @1450 msg/s 需
# 7250 块（远超 40）⇒ 吞吐 = **块回收速率**而非传输带宽 ⇒ 对调度/唤醒抖动极敏感。
#
# ⇒ 因此该档**换判据形态**（换判据本身，不是"抬阈值放行"）：
#   ① **前置过滤**：只有发布端未阻塞（`tput.failed == 0`）的轮才进统计
#      —— 发布端阻塞本身就是"本轮未达成开环"的证据，不该与"被打塌"混算；
#   ② **采样到「至少 5 个可用轮」为止取中位数**（单轮不作判据）。
#      ⚠️ 实测修正：`failed==0` 的自然占比只约 40%（30 轮标定 12/30），"固定跑 5 轮"
#      常常只拿到 1–2 个可用轮（本脚本首次实跑即 1/5）⇒ 改为**跑到 ≥5 个可用轮
#      或触顶 MAX_ATTEMPTS_1M=15 轮为止**，并把「采样轮数 / 可用轮数」并列报出。
#      触顶仍 <5 个可用轮 ⇒ ⛔ **不判通过**、也不静默降低要求：判失败并提示
#      提高采样或换独占窗口（避免用 1–2 轮的中位数冒充"多轮判定"）；
#   ③ **下限 1100 msg/s** = 条件化峰顶中位 1431 的 0.77×（实测条件化后 n=12：
#      1407–1453、CV 0.9%，bootstrap ≥5 轮取中位 p05 ≥ 1414 ⇒ 留余量）；
#      取 1100 而非 1200：最高失败值 1171 那轮**带 failed=8**，会被 ① 剔除，
#      故不必靠抬下限去分它；1200 与峰顶最小 1274 仅差 6%，余量偏薄；
#   ④ **并列报**：`sent/recv/failed/轮数` 与判定同行输出；
#   ⑤ **⚠️ 判据诚实命名**：条件化后它测的是「**chunk 池周转/回收**」，
#      ⛔ 不是「1 MiB 传输带宽」；报告与引用不得写成"1 MiB 吞吐非回归"。
# ⛔ 64 B 档**不改**：同一批标定 6 轮 = 163499–171058 msg/s、CV 1.85%，
#    对下限 80000 有 2.1× 余量 ⇒ 单轮判据在该档充分。
#
# 基线：1 MiB 条件化中位 1431（2026-09-30 本机 30 轮标定，pin=5,6，governor=powersave）；
#       64 B → 169741 msg/s（2026-09-21 aa7e00c 干净树）。
# 标定原始读数：团队改造交付/W00/t40_热闸1MiB标定/（逐轮表 + 30 轮输出 + 三支可重跑脚本）
FLOOR_1M_COND=1100
MIN_KEEP_1M=5           # 至少要有这么多个「可用轮」（failed==0 且 rc==0）才出结论
MAX_ATTEMPTS_1M=15      # 采样触顶（防在 failed>0 高发期无限重跑）
ZERO_DELIVERY_MAX=0.35  # 零投递轮（rc!=0）占比上限；标定基线 ~13%（4/30）
FLOOR_64=80000

# ---- 64 B 档（单轮，判据未变）----
clear_pool
f="$OUT/tput_64.txt"
timeout 200 "${BUILD_DIR}/bin/dzipc_perf_benchmark" --cases=pubsub_shm \
    --payloads=64 --duration=5 --pin=5,6 --out="$OUT/perf_64" >"$f" 2>&1
line="$(grep -E "64B_tput" "$f" | head -1)"
rate="$(printf '%s' "$line" | grep -oE '[0-9]+ msg/s' | head -1 | grep -oE '[0-9]+')"
if printf '%s' "$line" | grep -qiE "FAILED|no message"; then
    printf '  ✗ payload=%-8s 未投递: %s\n' 64 "$(printf '%s' "$line" | sed 's/^ *//')"; fail=1
elif [ -z "$rate" ] || [ "$rate" -lt "$FLOOR_64" ]; then
    printf '  ✗ payload=%-8s 速率 %s msg/s < 下限 %d —— 没报错但被打塌\n' 64 "${rate:-NA}" "$FLOOR_64"; fail=1
else
    printf '  ✓ payload=%-8s %s\n' 64 "$(printf '%s' "$line" | sed 's/^ *//')"
fi

# ---- 1 MiB 档（条件化 + ≥5 轮取中位）----
r=0
kept=0
: >"$OUT/1m_rounds.csv"
echo "round,recv_per_s,failed,rc" >>"$OUT/1m_rounds.csv"
while [ "$r" -lt "$MAX_ATTEMPTS_1M" ] && [ "$kept" -lt "$MIN_KEEP_1M" ]; do
    r=$((r + 1))
    clear_pool
    f="$OUT/tput_1048576_r$r.txt"
    timeout 200 "${BUILD_DIR}/bin/dzipc_perf_benchmark" --cases=pubsub_shm \
        --payloads=1048576 --duration=5 --pin=5,6 --out="$OUT/perf_1048576_r$r" >"$f" 2>&1
    rc=$?
    line="$(grep -E "1048576B_tput" "$f" | head -1)"
    rate="$(printf '%s' "$line" | grep -oE '[0-9]+ msg/s' | head -1 | grep -oE '[0-9]+')"
    # 发布端阻塞数：从同次运行的 results.json 取 tput 档的 failed（不采信 stdout 文本）
    blk="$(python3 - "$OUT/perf_1048576_r$r/results.json" <<'PY' 2>/dev/null || echo NA
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("NA"); raise SystemExit
for c in d.get("cases", d.get("results", [])):
    if c.get("test_kind") == "tput":
        print(c.get("failed", 0)); break
else:
    print("NA")
PY
)"
    printf '%s,%s,%s,%s\n' "$r" "${rate:-0}" "$blk" "$rc" >>"$OUT/1m_rounds.csv"
    [ "$blk" = "0" ] && [ "$rc" = "0" ] && kept=$((kept + 1))
done
python3 - "$OUT/1m_rounds.csv" "$FLOOR_1M_COND" "$MIN_KEEP_1M" "$MAX_ATTEMPTS_1M" "$ZERO_DELIVERY_MAX" <<'PY'
import csv, statistics, sys
path, floor, min_keep, max_att, zr_max = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4]), float(sys.argv[5])
rows = [(int(a), int(b or 0), int(c or 0), int(d or 0))
        for a, b, c, d in csv.reader(open(path)) if a.isdigit()]   # (round, recv_per_s, failed, rc)
allr = [rate for _, rate, _, _ in rows]
kept = [rate for _, rate, failed, rc in rows if failed == 0 and rc == 0]
zero = [r for r, _, _, rc in rows if rc != 0]
zr = len(zero) / len(rows) if rows else 0.0
print(f"  1 MiB 档：采样 {len(rows)} 轮（触顶 {max_att}）；可用轮（failed==0 且 rc==0）"
      f"= {len(kept)}/{len(rows)}（门槛 {min_keep}）；零投递轮（rc!=0）= {len(zero)}/{len(rows)}"
      f"（{zr:.0%}，标定基线 ~13%）；全部读数 = {allr}")
# ⛔ **本档最初的职责就是抓"零投递"**（A′ 把 1 MB 打到 no message recv）⇒
#    零投递轮虽然被前置过滤排除出「可用轮」，但**比例本身必须守住**，
#    否则"回归把一半轮打到零投递"会被"取到 5 个好的就行"掩盖。
if zr > zr_max:
    print(f"  ✗ payload=1048576 **零投递轮占比 {zr:.0%} > 上限 {zr_max:.0%}**"
          f"（标定基线 ~13%）⇒ 判失败：这已不是池周转抖动，而是「被打到零投递」的回归")
    sys.exit(1)
if not kept:
    print(f"  ✗ payload=1048576 全部 {len(rows)} 轮发布端阻塞或非零退出 ⇒ 未达成开环，判失败"); sys.exit(1)
if len(kept) < min_keep:
    print(f"  ✗ payload=1048576 **INCONCLUSIVE**：可用轮仅 {len(kept)} < {min_keep}"
          f"（已触顶 {len(rows)} 轮采样）⇒ **不判通过**（⛔ 不用 1–2 轮的中位数冒充多轮判定）。"
          f"请提高 MAX_ATTEMPTS_1M 或换独占窗口重跑（标定实测 failed==0 占比约 40%）。\n"
          f"     ⚠️ 与「产品回归」的区别：本行的判据是**采样不足**，不是读数不达标 —— "
          f"交接时必须按 INCONCLUSIVE 记，⛔ 不得写成「1 MiB 档回归」。"); sys.exit(1)
med = statistics.median(kept)
ok = med >= floor
print(f"  {'✓' if ok else '✗'} payload=1048576 条件化中位 = {med:.0f} msg/s "
      f"(下限 {floor}；条件化 min={min(kept)} max={max(kept)} n={len(kept)})")
print(f"      ⚠️ 判据诚实命名：本档测的是 **chunk 池周转/回收**，⛔ 不是「1 MiB 传输带宽」"
      f"（W00 §11.4 D-30）")
sys.exit(0 if ok else 1)
PY
[ $? -ne 0 ] && fail=1

echo "==> 门 2: 邻接回归"
for t in test_uf011_chunk_return test_chunk_hold test_lap_safety \
         test_uf007_id_pool_double_release test_loan \
         test_dzflat_transport test_dzflat_rx test_dzflat_sercli; do
    clear_pool
    f="$OUT/$t.txt"
    timeout 600 "${BUILD_DIR}/bin/$t" >"$f" 2>&1
    rc=$?
    ok=$(grep -cE '^\[       OK \]' "$f")
    bad=$(grep -cE '^\[  FAILED  \]' "$f")
    if [ "$rc" -ne 0 ] || [ "$bad" -ne 0 ]; then
        printf '  ✗ %-38s rc=%d OK=%d FAILED=%d\n' "$t" "$rc" "$ok" "$bad"; fail=1
    else
        printf '  ✓ %-38s OK=%d\n' "$t" "$ok"
    fi
done

echo
if [ "$fail" -eq 0 ]; then echo "过闸。（run_id=${RUN_ID}，读数在 ${OUT}/）"
else echo "⛔ 未过闸 —— 逐项读数在 ${OUT}/（run_id=${RUN_ID}）"; fi
exit "$fail"
